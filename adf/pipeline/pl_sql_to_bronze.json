{
  "name": "pl_sql_to_bronze",
  "properties": {
    "description": "Charge les tables listées dans etl.ControlTable vers Bronze, en incrémental (watermark).",
    "activities": [
      {
        "name": "lkp_control_table",
        "type": "Lookup",
        "policy": {
          "timeout": "0.01:00:00",
          "retry": 2,
          "retryIntervalInSeconds": 60,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "source": {
            "type": "AzureSqlSource",
            "sqlReaderQuery": "SELECT Id, SourceSchema, SourceTable, WatermarkColumn, CONVERT(varchar(23), LastWatermark, 121) AS LastWatermark, BronzeFolder FROM etl.ControlTable WHERE IsActive = 1"
          },
          "dataset": {
            "referenceName": "ds_sql_query",
            "type": "DatasetReference"
          },
          "firstRowOnly": false
        }
      },
      {
        "name": "fe_tables",
        "type": "ForEach",
        "dependsOn": [
          {
            "activity": "lkp_control_table",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "items": {
            "value": "@activity('lkp_control_table').output.value",
            "type": "Expression"
          },
          "isSequential": false,
          "batchCount": 4,
          "activities": [
            {
              "name": "lkp_new_watermark",
              "type": "Lookup",
              "policy": {
                "timeout": "0.01:00:00",
                "retry": 2,
                "retryIntervalInSeconds": 60,
                "secureOutput": false,
                "secureInput": false
              },
              "typeProperties": {
                "source": {
                  "type": "AzureSqlSource",
                  "sqlReaderQuery": {
                    "value": "SELECT CONVERT(varchar(23), ISNULL(MAX([@{item().WatermarkColumn}]), '1900-01-01'), 121) AS NewWatermark FROM [@{item().SourceSchema}].[@{item().SourceTable}]",
                    "type": "Expression"
                  }
                },
                "dataset": {
                  "referenceName": "ds_sql_query",
                  "type": "DatasetReference"
                },
                "firstRowOnly": true
              }
            },
            {
              "name": "cp_sql_to_bronze",
              "type": "Copy",
              "dependsOn": [
                {
                  "activity": "lkp_new_watermark",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "policy": {
                "timeout": "0.01:00:00",
                "retry": 2,
                "retryIntervalInSeconds": 60,
                "secureOutput": false,
                "secureInput": false
              },
              "typeProperties": {
                "source": {
                  "type": "AzureSqlSource",
                  "sqlReaderQuery": {
                    "value": "SELECT * FROM [@{item().SourceSchema}].[@{item().SourceTable}] WHERE [@{item().WatermarkColumn}] > '@{item().LastWatermark}' AND [@{item().WatermarkColumn}] <= '@{activity('lkp_new_watermark').output.firstRow.NewWatermark}'",
                    "type": "Expression"
                  }
                },
                "sink": {
                  "type": "ParquetSink",
                  "storeSettings": {
                    "type": "AzureBlobFSWriteSettings"
                  }
                },
                "enableStaging": false
              },
              "inputs": [
                {
                  "referenceName": "ds_sql_query",
                  "type": "DatasetReference"
                }
              ],
              "outputs": [
                {
                  "referenceName": "ds_adls_parquet",
                  "type": "DatasetReference",
                  "parameters": {
                    "container": "bronze",
                    "folder": {
                      "value": "@{item().BronzeFolder}/load_date=@{formatDateTime(utcNow(),'yyyy-MM-dd')}",
                      "type": "Expression"
                    },
                    "file": {
                      "value": "@{item().SourceTable}_@{pipeline().RunId}.parquet",
                      "type": "Expression"
                    }
                  }
                }
              ]
            },
            {
              "name": "sp_update_watermark",
              "type": "SqlServerStoredProcedure",
              "dependsOn": [
                {
                  "activity": "cp_sql_to_bronze",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "policy": {
                "timeout": "0.01:00:00",
                "retry": 2,
                "retryIntervalInSeconds": 60,
                "secureOutput": false,
                "secureInput": false
              },
              "linkedServiceName": {
                "referenceName": "ls_azuresql",
                "type": "LinkedServiceReference"
              },
              "typeProperties": {
                "storedProcedureName": "[etl].[usp_UpdateWatermark]",
                "storedProcedureParameters": {
                  "Id": {
                    "value": {
                      "value": "@item().Id",
                      "type": "Expression"
                    },
                    "type": "Int32"
                  },
                  "NewWatermark": {
                    "value": {
                      "value": "@activity('lkp_new_watermark').output.firstRow.NewWatermark",
                      "type": "Expression"
                    },
                    "type": "DateTime"
                  },
                  "RowsCopied": {
                    "value": {
                      "value": "@activity('cp_sql_to_bronze').output.rowsCopied",
                      "type": "Expression"
                    },
                    "type": "Int32"
                  }
                }
              }
            }
          ]
        }
      }
    ],
    "folder": {
      "name": "ingestion"
    },
    "annotations": [
      "metadata-driven",
      "incremental"
    ]
  }
}